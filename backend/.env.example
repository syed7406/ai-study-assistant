# Free-first setup. Ollama runs locally and does not need an API key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Optional cloud providers if you later want them.
GEMINI_API_KEY=
OPENAI_API_KEY=

CHROMA_PERSIST_DIR=./chroma_db
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
